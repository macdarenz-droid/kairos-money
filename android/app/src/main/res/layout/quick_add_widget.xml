<?xml version="1.0" encoding="utf-8"?>
<!--
  THE WIDGET, AFTER LINEAR: one near-black card, a hairline border, a caps label, a ring for the plus,
  and four category chips. It shows no money. Everything on it is a tap that opens the quick-add sheet
  over the home screen; nothing here opens the app.

  RemoteViews rules shape it: LinearLayout, TextView, ImageButton and ViewFlipper only. The flipper is
  the one animation a widget can own — it fades between "Kairos · Add" and "Saved …" for a few seconds
  after the sheet saves, then fades back.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="12dp" android:paddingBottom="12dp" android:background="@drawable/widget_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ViewFlipper android:id="@+id/widget_flip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:autoStart="false" android:inAnimation="@anim/qa_rise_in" android:outAnimation="@anim/qa_sink_out" android:animateFirstView="false">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_label" android:textAllCaps="true" android:textSize="11sp" android:letterSpacing="0.04"
                android:textColor="@color/qa_meta" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/widget_saved" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_qa_check" android:drawableTint="@color/qa_accent" android:drawablePadding="6dp" android:gravity="center_vertical"
                android:textSize="12sp" android:textColor="@color/qa_text" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
        </ViewFlipper>
        <ImageButton android:id="@+id/widget_add" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="8dp"
            android:background="@drawable/qa_ring_ripple" android:src="@drawable/ic_qa_plus" android:tint="@color/qa_accent"
            android:scaleType="centerInside" android:padding="7dp" android:contentDescription="@string/widget_add"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
        <TextView android:id="@+id/widget_chip_1" style="@style/Widget.Kairos.Chip"/>
        <TextView android:id="@+id/widget_chip_2" style="@style/Widget.Kairos.Chip" android:layout_marginStart="8dp"/>
        <TextView android:id="@+id/widget_chip_3" style="@style/Widget.Kairos.Chip" android:layout_marginStart="8dp"/>
        <TextView android:id="@+id/widget_chip_4" style="@style/Widget.Kairos.Chip" android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
