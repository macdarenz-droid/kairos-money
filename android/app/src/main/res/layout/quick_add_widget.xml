<?xml version="1.0" encoding="utf-8"?>
<!-- W2, 4×1: three category chips and add in one slim row. After a save the chips flip to "Saved …" and back. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="6dp" android:background="@drawable/widget_bg_glass">
    <ViewFlipper android:id="@+id/widget_flip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:autoStart="false" android:inAnimation="@anim/qa_rise_in" android:outAnimation="@anim/qa_sink_out" android:animateFirstView="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <android.widget.TextView android:id="@+id/widget_chip_1" style="@style/Widget.Kairos.WidgetChip"/>
            <android.widget.TextView android:id="@+id/widget_chip_2" style="@style/Widget.Kairos.WidgetChip" android:layout_marginStart="6dp"/>
            <android.widget.TextView android:id="@+id/widget_chip_3" style="@style/Widget.Kairos.WidgetChip" android:layout_marginStart="6dp"/>
        </LinearLayout>
        <android.widget.TextView android:id="@+id/widget_saved" android:layout_width="match_parent" android:layout_height="44dp"
            android:drawableStart="@drawable/ic_qa_check" android:drawableTint="@color/widget_chip_icon" android:drawablePadding="6dp"
            android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:textSize="12sp" android:textColor="@color/widget_glass_text" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
    </ViewFlipper>
    <android.widget.ImageButton android:id="@+id/widget_add" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="6dp"
        android:background="@drawable/widget_tap" android:src="@drawable/ic_qa_plus" android:scaleType="centerInside" android:padding="11dp"
        android:contentDescription="@string/widget_add"/>
</LinearLayout>
