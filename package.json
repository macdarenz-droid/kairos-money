{
  "name": "kairos-money",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run tokens && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src tests scripts eslint.config.mjs",
    "tokens": "node scripts/tokens.mjs",
    "schema": "node scripts/schema-doc.mjs",
    "release:config": "node scripts/verify-release-config.mjs",
    "device:strings": "node scripts/device-strings.mjs",
    "check": "npm run lint && npm run device:strings && npm run test && npm run build && npm run schema && npm run release:config",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "dev:fixtures": "tsx scripts/seed-fixtures.ts"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "6.0.2",
    "@capacitor/android": "6.2.2",
    "@capacitor/app": "6.0.2",
    "@capacitor/core": "6.2.2",
    "@capacitor/filesystem": "6.0.3",
    "@capawesome/capacitor-file-picker": "6.2.0",
    "@fontsource-variable/inter": "5.2.8",
    "@noble/hashes": "1.8.0",
    "@tanstack/react-query": "5.90.2",
    "drizzle-orm": "0.44.5",
    "fflate": "0.8.2",
    "lucide-react": "0.468.0",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "@eslint/js": "9.36.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.6",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.36.0",
    "fast-check": "4.3.0",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
